[Unit]
Description=MXW01 cat printer IPP front-end
# Deliberately no After=bluetooth.service / cups.service. This is a USER unit,
# and in a user manager those names resolve to user units that do not exist —
# so the ordering systemd creates is none at all. It needs none: the daemon is
# idle by design and only touches the radio inside a job.

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/run-mxw01d
# One radio, one printer, one owner. A second session exits 0 with a log line
# (EADDRINUSE), so this retry is how it takes over when the first logs out.
Restart=always
RestartSec=30

[Install]
WantedBy=@WANTEDBY@
