# /etc/catprinter/env — per-machine settings for catprinter.service and catprinter-queue.service.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no shell expansion.
# After editing:  sudo systemctl restart catprinter catprinter-queue
#
# Everything is optional; the defaults are the fleet defaults ("Bluetooth on, printer on, print").

# Pin one printer by MAC address or advertised name. Default: any known cat printer, strongest signal.
#CATPRINTER_DEVICE=AA:BB:CC:DD:EE:FF

# Force a protocol family instead of autodetecting: auto | mxw01 | classic
#CATPRINTER_MODEL=auto

# Loopback IPP port. Must match the CUPS queue URI (catprinter-queue.service uses the same value).
#CATPRINTER_PORT=8095

# Seconds a job keeps retrying to reach the printer ("turn it on") before it is aborted.
#CATPRINTER_PRINTER_WAIT=600

# Log level / filter: info | debug | trace, or a tracing filter such as catprinterd::ble=debug
#CATPRINTER_LOG=info

# CUPS queue name created/maintained by catprinter-queue.service.
#CATPRINTER_QUEUE=CatPrinter

# printer-location shown in print dialogs.
#CATPRINTER_LOCATION=Bluetooth, wherever the cat printer is

# Fixed printer-uuid (default: adopt the CUPS queue's uuid so dialogs show one Cat Printer).
#CATPRINTER_UUID=urn:uuid:12345678-1234-5678-1234-567812345678

# Advertise on Avahi (loopback _ipp._tcp) for discovery: on | off
#CATPRINTER_DNSSD=on

# Extra daemon arguments (word-split by systemd). Testing without a printer:
#CATPRINTERD_ARGS=--fake-printer /var/lib/catprinter/fake
