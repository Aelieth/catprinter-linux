# /etc/catprinter/env — per-machine settings for catprinter.service and catprinter-queue.service.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no shell expansion.
# After editing:  sudo systemctl restart catprinter catprinter-queue
#
# Everything is optional; the defaults are the fleet defaults ("Bluetooth on, printer on, print").

# Pin one printer by MAC address or advertised name. Default: any known cat printer, strongest signal.
#CATPRINTER_DEVICE=AA:BB:CC:DD:EE:FF

# Force a protocol family instead of autodetecting: auto | mxw01 | classic
#CATPRINTER_MODEL=auto

# Loopback IPP port. Must match the CUPS queue URI (catprinter-queue.service uses the same value).
#CATPRINTER_PORT=8095

# Seconds a job keeps retrying to reach the printer ("turn it on") before it is aborted.
#CATPRINTER_PRINTER_WAIT=120

# Log level / filter: info | debug | trace, or a tracing filter such as catprinterd::ble=debug
#CATPRINTER_LOG=info

# CUPS queue name created/maintained by catprinter-queue.service.
#CATPRINTER_QUEUE=CatPrinter

# printer-location shown in print dialogs.
#CATPRINTER_LOCATION=Bluetooth, wherever the cat printer is

# Fixed printer-uuid. Default: the daemon adopts the CUPS queue's uuid so dialogs show one Cat
# Printer (before adoption it uses a v5 uuid derived from machine-id:port). Setting this disables
# the adopter — only pin it if you know why.
#CATPRINTER_UUID=urn:uuid:12345678-1234-5678-1234-567812345678

# Advertise on Avahi (loopback _ipp._tcp) for discovery: on | off
#CATPRINTER_DNSSD=on

# Extra daemon arguments (word-split by systemd). Testing without a printer:
#CATPRINTERD_ARGS=--fake-printer /var/lib/catprinter/fake
# Do NOT put --port/--queue/--bind here: catprinter-queue.service and install.sh only read
# CATPRINTER_PORT / CATPRINTER_QUEUE, so the daemon and the CUPS queue would disagree.

# ---- advanced (rarely needed; each maps to a `catprinterd serve --help` flag; values shown are the
# defaults). No trailing comments on value lines: systemd would make them part of the value.
# Bluetooth adapter to use on multi-adapter machines (hci0, hci1, …); default: first powered adapter.
#CATPRINTER_ADAPTER=hci0
# One row per BLE write with extra pacing (weak links); ms between bulk writes (classic family >= 20).
#CATPRINTER_SLOW=false
#CATPRINTER_PACING_MS=8
# How printer notifications are received: props (BlueZ PropertiesChanged) | acquire (AcquireNotify fd).
#CATPRINTER_NOTIFY_MODE=props
# Listen address. Loopback is the design (the unit denies other addresses); the queue URI must match.
#CATPRINTER_BIND=127.0.0.1
# Waiting jobs before Print-Job answers server-error-busy; largest accepted document (MiB, inflated).
#CATPRINTER_QUEUE_MAX=16
#CATPRINTER_MAX_DOCUMENT_MB=64
# Longest strip in head lines (203 lines ≈ 25.4 mm; longer jobs are rejected, never truncated), lines
# per printer request (long strips are segmented), copies honoured per job.
#CATPRINTER_MAX_LINES=8000
#CATPRINTER_MAX_LINES_PER_REQUEST=4000
#CATPRINTER_MAX_COPIES=10
# Advertised resolutions (dpi, comma-separated); "203,406" makes CUPS render Normal/High at 406 dpi.
#CATPRINTER_RESOLUTIONS=203
# DNS-SD instance name (<= 63 bytes) and IPP printer-name.
#CATPRINTER_DNSSD_NAME=Cat Printer
#CATPRINTER_PRINTER_NAME=CatPrinter
# Same as CATPRINTERD_ARGS=--fake-printer DIR (testing without a printer).
#CATPRINTER_FAKE_PRINTER=/var/lib/catprinter/fake
