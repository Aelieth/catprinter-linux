# Fleet-path test image (scripts/fleet-test.sh): a systemd "machine" that boots with podman
# (--systemd=always --privileged) and holds the kit, the image-root files and a raster fixture.
#
#   BASE / DISTRO  select the distro; the per-distro provisioner (tests/fleet/provision/<distro>.sh)
#                  installs the base packages, sets the fleet-like unit state (that distro's unit
#                  names) and writes a fixed machine-id. Defaults: fedora.
#   IMAGE_BAKED=1  -> the image-root files are baked in (what a uBlue image built from
#                     `make image-files` looks like: /usr/bin/catprinterd, /usr/lib/systemd/system
#                     units, multi-user.target.wants symlinks, preset, /usr/lib/catprinter/*)
#   IMAGE_BAKED=0  -> plain machine; the kit path (/kit/install.sh) and the kit->image migration
#                     (cp -an /image-root/. /) are exercised at run time.
#
# The build context is assembled by scripts/fleet-test.sh under tests/out/fleet/ctx/ (kit/,
# image-root/, fixtures/, provision/) — never the repo root.
ARG BASE=registry.fedoraproject.org/fedora:44
FROM ${BASE}

# Distro-specific provisioning (packages + fleet-like unit state + fixed machine-id). Run via `sh` so
# the build does not depend on the copied file keeping its executable bit.
ARG DISTRO=fedora
COPY provision/ /provision/
RUN sh /provision/${DISTRO}.sh

COPY kit/        /kit/
COPY image-root/ /image-root/
COPY fixtures/   /fixtures/

ARG IMAGE_BAKED=1
RUN if [ "$IMAGE_BAKED" = 1 ]; then cp -a /image-root/. /; fi

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
