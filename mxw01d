#!/usr/bin/env python
"""Localhost IPP front-end for the MXW01. Run as the logged-in user.

cupsd talks to 127.0.0.1:8095; this process owns Bluetooth.

Idle on purpose: no BLE scan, no presence ping. Get-Printer-Attributes
does not touch the radio. We connect only inside run_job, then disconnect.
"""

from __future__ import annotations

import argparse
import asyncio
import errno
import logging
import os
import sys
import time
from dataclasses import dataclass, field

_ROOT = os.path.dirname(os.path.realpath(__file__))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from catprinter import NOT_FOUND, __version__, logger, which
from catprinter.ipp import (
    JOB_ABORTED,
    JOB_CANCELED,
    JOB_COMPLETED,
    JOB_PENDING,
    JOB_PROCESSING,
    OP_CANCEL_JOB,
    OP_CREATE_JOB,
    OP_GET_JOB_ATTRIBUTES,
    OP_GET_JOBS,
    OP_GET_PRINTER_ATTRIBUTES,
    OP_PRINT_JOB,
    OP_SEND_DOCUMENT,
    OP_VALIDATE_JOB,
    PRINTER_IDLE,
    PRINTER_PROCESSING,
    PRINTER_STOPPED,
    STATUS_CLIENT_NOT_FOUND,
    STATUS_OK,
    STATUS_SERVER_BUSY,
    STATUS_SERVER_INTERNAL,
    TAG_JOB,
    TAG_PRINTER,
    build_response,
    job_attributes,
    now_uptime,
    parse_ipp,
    printer_attributes,
    media_type_from_request,
    quality_from_request,
    tone_from_request,
)

DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 8095
DEFAULT_NAME = "CatPrinter"


def printer_uri(host: str, port: int) -> str:
    """The daemon's identity, derived from what it actually bound."""
    return f"ipp://{host}:{port}/ipp/print"


@dataclass
class Job:
    job_id: int
    name: str
    quality: str
    tone: str = "blackwhite"
    media_type: str = "paper"
    document: bytes = b""
    filename_hint: str = ""
    state: int = JOB_PENDING
    message: str = ""
    created: float = field(default_factory=time.time)


class Mxw01Daemon:
    def __init__(
        self,
        device: str | None = None,
        uri: str | None = None,
        name: str = DEFAULT_NAME,
    ) -> None:
        self.device = device
        self.uri = uri or printer_uri(DEFAULT_HOST, DEFAULT_PORT)
        self.name = name
        self.started = time.time()
        self.jobs: dict[int, Job] = {}
        self.next_id = 1
        self.lock = asyncio.Lock()
        self.busy = False
        self.last_error: str | None = None

    def _printer_state(self) -> tuple[int, list[str], bool]:
        if self.busy:
            return PRINTER_PROCESSING, ["moving-to-paused"] if False else ["none"], True
        if self.last_error == NOT_FOUND:
            return PRINTER_STOPPED, ["offline-report"], True
        if self.last_error and "paper" in (self.last_error or "").lower():
            return PRINTER_STOPPED, ["media-empty-error"], True
        return PRINTER_IDLE, ["none"], True

    def _job_uri(self, job_id: int) -> str:
        return f"{self.uri}/jobs/{job_id}"

    def handle_ipp(self, raw: bytes) -> tuple[bytes, Job | None]:
        """Pure request/response. Returns (ipp-bytes, job-to-run-or-None)."""
        try:
            req = parse_ipp(raw)
        except ValueError:
            return b"", None

        state, reasons, accepting = self._printer_state()
        uptime = now_uptime(self.started)
        queued = sum(1 for j in self.jobs.values() if j.state in {JOB_PENDING, JOB_PROCESSING})

        if req.operation == OP_GET_PRINTER_ATTRIBUTES:
            body = printer_attributes(
                printer_uri=self.uri,
                name=self.name,
                state=state,
                reasons=reasons,
                accepting=accepting,
                queued=queued,
                uptime=uptime,
            )
            return build_response(req, STATUS_OK, [(TAG_PRINTER, body)]), None

        if req.operation == OP_VALIDATE_JOB:
            return build_response(req, STATUS_OK, []), None

        if req.operation == OP_GET_JOBS:
            groups = []
            for job in self.jobs.values():
                groups.append((
                    TAG_JOB,
                    job_attributes(
                        job_id=job.job_id,
                        job_uri=self._job_uri(job.job_id),
                        printer_uri=self.uri,
                        state=job.state,
                        name=job.name,
                    ),
                ))
            return build_response(req, STATUS_OK, groups), None

        if req.operation == OP_GET_JOB_ATTRIBUTES:
            job_id = req.get_int("job-id")
            uri = req.get("job-uri") or ""
            if job_id is None and "/jobs/" in uri:
                try:
                    job_id = int(uri.rstrip("/").rsplit("/", 1)[-1])
                except ValueError:
                    job_id = None
            job = self.jobs.get(job_id or -1)
            if job is None:
                return build_response(req, STATUS_CLIENT_NOT_FOUND, []), None
            body = job_attributes(
                job_id=job.job_id,
                job_uri=self._job_uri(job.job_id),
                printer_uri=self.uri,
                state=job.state,
                name=job.name,
            )
            return build_response(req, STATUS_OK, [(TAG_JOB, body)]), None

        if req.operation == OP_CANCEL_JOB:
            job_id = req.get_int("job-id")
            job = self.jobs.get(job_id or -1)
            if job is None:
                return build_response(req, STATUS_CLIENT_NOT_FOUND, []), None
            if job.state in {JOB_PENDING}:
                job.state = JOB_CANCELED
            return build_response(req, STATUS_OK, []), None

        if req.operation == OP_CREATE_JOB:
            quality = _safe_quality(quality_from_request(req))
            tone = _safe_tone(tone_from_request(req))
            media_type = media_type_from_request(req)
            job = Job(
                job_id=self.next_id,
                name=req.get("job-name") or "print",
                quality=quality,
                tone=tone,
                media_type=media_type,
            )
            self.next_id += 1
            self.jobs[job.job_id] = job
            body = job_attributes(
                job_id=job.job_id,
                job_uri=self._job_uri(job.job_id),
                printer_uri=self.uri,
                state=job.state,
                name=job.name,
            )
            return build_response(req, STATUS_OK, [(TAG_JOB, body)]), None

        if req.operation == OP_SEND_DOCUMENT:
            job_id = req.get_int("job-id")
            job = self.jobs.get(job_id or -1)
            if job is None:
                return build_response(req, STATUS_CLIENT_NOT_FOUND, []), None
            job.document = req.document
            job.filename_hint = req.get("document-name-supplied") or job.name
            if self.busy:
                return build_response(req, STATUS_SERVER_BUSY, []), None
            job.state = JOB_PROCESSING
            body = job_attributes(
                job_id=job.job_id,
                job_uri=self._job_uri(job.job_id),
                printer_uri=self.uri,
                state=job.state,
                name=job.name,
            )
            return build_response(req, STATUS_OK, [(TAG_JOB, body)]), job

        if req.operation == OP_PRINT_JOB:
            if self.busy:
                return build_response(req, STATUS_SERVER_BUSY, []), None
            quality = _safe_quality(quality_from_request(req))
            tone = _safe_tone(tone_from_request(req))
            media_type = media_type_from_request(req)
            job = Job(
                job_id=self.next_id,
                name=req.get("job-name") or "print",
                quality=quality,
                tone=tone,
                media_type=media_type,
                document=req.document,
                filename_hint=req.get("job-name") or "document.pdf",
                state=JOB_PROCESSING,
            )
            self.next_id += 1
            self.jobs[job.job_id] = job
            body = job_attributes(
                job_id=job.job_id,
                job_uri=self._job_uri(job.job_id),
                printer_uri=self.uri,
                state=job.state,
                name=job.name,
            )
            return build_response(req, STATUS_OK, [(TAG_JOB, body)]), job

        return build_response(req, STATUS_OK, []), None

    async def run_job(self, job: Job) -> None:
        # Imported here, not at module scope: --check and --version must work
        # on a machine whose venv is broken, which is the only machine anyone
        # runs them on. Nothing above this line may need bleak or numpy.
        from catprinter.ble import MXW01
        from catprinter.render import render_to_buffer

        async with self.lock:
            self.busy = True
            self.last_error = None
            job.state = JOB_PROCESSING
            try:
                if not job.document:
                    raise RuntimeError("Empty print job")
                def _render():
                    return render_to_buffer(
                        data=job.document,
                        filename_hint=job.filename_hint,
                        quality=job.quality,
                        tone=job.tone,
                    )

                buffer, rendered = await asyncio.to_thread(_render)
                logger.info(
                    "🖨️  CUPS job %s (%s/%s, %s, %s lines)",
                    job.job_id,
                    rendered.quality,
                    rendered.tone,
                    job.media_type,
                    rendered.bitmap.shape[0],
                )
                # BLE only for this job. MXW01.__aexit__ drops the link.
                async with MXW01(self.device) as printer:
                    await printer.print_image(
                        buffer, intensity=rendered.intensity, mode=rendered.mode
                    )
                job.state = JOB_COMPLETED
                logger.info("✅ Job %s done", job.job_id)
            except Exception as exc:  # noqa: BLE001
                job.state = JOB_ABORTED
                job.message = str(exc)
                self.last_error = str(exc)
                logger.error("🛑 Job %s failed: %s", job.job_id, exc)
            finally:
                self.busy = False


def _safe_quality(name: str) -> str:
    from catprinter.render import normalize_quality

    try:
        return normalize_quality(name)
    except RuntimeError:
        return "default"


def _safe_tone(name: str) -> str:
    from catprinter.render import normalize_tone

    try:
        return normalize_tone(name)
    except RuntimeError:
        return "blackwhite"


async def _read_http(reader: asyncio.StreamReader) -> dict[str, str]:
    header_blob = await reader.readuntil(b"\r\n\r\n")
    lines = header_blob.decode("iso-8859-1", "replace").split("\r\n")
    request_line = lines[0]
    headers = {}
    for line in lines[1:]:
        if ":" in line:
            k, v = line.split(":", 1)
            headers[k.strip().lower()] = v.strip()
    headers[":method"] = request_line.split(" ")[0].upper() if request_line else "GET"
    headers[":path"] = request_line.split(" ")[1] if " " in request_line else "/"
    return headers


async def _read_body(reader: asyncio.StreamReader, headers: dict[str, str]) -> bytes:
    length = int(headers.get("content-length", "0") or 0)
    if length:
        return await reader.readexactly(length)
    if headers.get("transfer-encoding", "").lower() == "chunked":
        chunks = []
        while True:
            line = await reader.readline()
            size = int(line.split(b";", 1)[0].strip() or b"0", 16)
            if size == 0:
                await reader.readline()
                break
            chunks.append(await reader.readexactly(size))
            await reader.readline()
        return b"".join(chunks)
    return b""


async def _client(daemon: Mxw01Daemon, reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    # cupsd keeps the HTTP connection open: Create-Job then Send-Document.
    try:
        while True:
            try:
                headers = await _read_http(reader)
            except (asyncio.IncompleteReadError, ConnectionResetError, asyncio.LimitOverrunError):
                return
            if headers.get("expect", "").lower() == "100-continue":
                writer.write(b"HTTP/1.1 100 Continue\r\n\r\n")
                await writer.drain()
            body = await _read_body(reader, headers)
            method = headers.get(":method", "GET")
            connection = headers.get("connection", "").lower()

            if method == "GET":
                payload = b"MXW01 IPP printer\n"
                writer.write(
                    b"HTTP/1.1 200 OK\r\n"
                    b"Content-Type: text/plain\r\n"
                    + f"Content-Length: {len(payload)}\r\n".encode()
                    + b"Connection: close\r\n\r\n"
                    + payload
                )
                await writer.drain()
                return

            if method != "POST":
                writer.write(b"HTTP/1.1 405 Method Not Allowed\r\nContent-Length: 0\r\n\r\n")
                await writer.drain()
                return

            logger.debug("IPP POST %s bytes", len(body))
            response, job = daemon.handle_ipp(body)
            if not response:
                writer.write(b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
                await writer.drain()
                return
            writer.write(
                b"HTTP/1.1 200 OK\r\n"
                b"Content-Type: application/ipp\r\n"
                + f"Content-Length: {len(response)}\r\n\r\n".encode()
                + response
            )
            await writer.drain()
            if job is not None:
                asyncio.create_task(daemon.run_job(job))
            if connection == "close":
                return
    except (asyncio.IncompleteReadError, ConnectionResetError, asyncio.LimitOverrunError):
        pass
    except Exception:  # noqa: BLE001
        logger.exception("IPP connection failed")
        try:
            writer.write(b"HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\n\r\n")
            await writer.drain()
        except Exception:
            pass
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass


async def serve(host: str, port: int, device: str | None,
                name: str = DEFAULT_NAME) -> None:
    uri = printer_uri(host, port)
    daemon = Mxw01Daemon(device=device, uri=uri, name=name)
    try:
        server = await asyncio.start_server(
            lambda r, w: _client(daemon, r, w),
            host=host,
            port=port,
            limit=32 * 1024 * 1024,
        )
    except OSError as exc:
        if exc.errno != errno.EADDRINUSE:
            raise
        # One radio, one printer, one owner. Exit 0 rather than fail: the unit
        # restarts on a timer and takes over when the other session ends.
        logger.info(
            "🐈 another session already owns the cat printer (%s) — standing by",
            uri,
        )
        return
    logger.info("🐈 catprinter %s — IPP listening on %s", __version__, uri)
    async with server:
        await server.serve_forever()


def run_check() -> int:
    """Is this install healthy? Answered WITHOUT switching the printer on."""
    import glob
    import platform

    ok = True
    print(f"catprinter    {__version__}")
    print(f"tree          {_ROOT}")
    print(f"python        {platform.python_version()}  ({sys.executable})")

    from importlib.metadata import PackageNotFoundError
    from importlib.metadata import version as _dist_version

    # (module, distribution). bleak and dbus-fast expose no __version__, so the
    # attribute alone reports "unknown" for precisely the two packages a fleet
    # diagnosis turns on. PIL's distribution is "pillow", not "PIL".
    for mod, dist in (
        ("bleak", "bleak"),
        ("dbus_fast", "dbus-fast"),
        ("numpy", "numpy"),
        ("PIL", "pillow"),
    ):
        try:
            m = __import__(mod)
            ver = getattr(m, "__version__", None)
            if not ver:
                try:
                    ver = _dist_version(dist)
                except PackageNotFoundError:
                    ver = "unknown"
            print(f"{mod:<13} {ver}")
        except Exception as exc:  # noqa: BLE001 — reporting, not handling
            print(f"{mod:<13} MISSING — {exc}")
            ok = False

    raster = which("pdftoppm") or which("gs")
    print(f"pdf raster    {raster or 'MISSING — needs poppler-utils or ghostscript'}")
    ok = ok and bool(raster)

    adapters = sorted(glob.glob("/sys/class/bluetooth/hci*"))
    print(
        f"bt adapter    {', '.join(os.path.basename(a) for a in adapters) or 'NONE FOUND'}"
    )
    ok = ok and bool(adapters)

    bus = os.environ.get("DBUS_SYSTEM_BUS_ADDRESS")
    if not bus:
        for cand in (
            "/run/dbus/system_bus_socket",
            "/var/run/dbus/system_bus_socket",
            "/run/host/run/dbus/system_bus_socket",
        ):
            if os.path.exists(cand):
                bus = f"unix:path={cand}"
                break
    print(f"system bus    {bus or 'NOT REACHABLE'}")
    ok = ok and bool(bus)

    print("result        " + ("ok" if ok else "NOT READY"))
    return 0 if ok else 1


def main() -> None:
    parser = argparse.ArgumentParser(description="MXW01 localhost IPP printer")
    parser.add_argument("--host", default=DEFAULT_HOST)
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("-d", "--device", default="")
    parser.add_argument(
        "-l", "--log-level", default="info", choices=["debug", "info", "warn", "error"]
    )
    parser.add_argument(
        "--version", action="store_true", help="print the driver version and exit"
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="verify this install without touching the printer, then exit",
    )
    args = parser.parse_args()
    if args.version:
        print(__version__)
        raise SystemExit(0)
    if args.check:
        raise SystemExit(run_check())
    logger.setLevel(getattr(logging, args.log_level.upper()))
    if not logger.handlers:
        handler = logging.StreamHandler(sys.stdout)
        handler.setLevel(logger.level)
        logger.addHandler(handler)
    try:
        asyncio.run(serve(args.host, args.port, args.device or None))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
